[Unit]
Description=SpoolPi store-and-forward buffer
# No After=network-online.target: SpoolPi must start and buffer while offline.

[Service]
Type=exec
# The stdin source needs a producer. Without one, systemd connects stdin to
# /dev/null, input ends at once, and Restart= would loop. Replace
# /usr/local/bin/read-sensors with whatever prints JSON lines such as
#   {"sensor_id": "t1", "value": 21.5, "unit": "C"}
# If the producer exits, SpoolPi ships what it has and exits, and systemd
# restarts the pipeline.
ExecStart=/bin/sh -c 'exec /usr/local/bin/read-sensors | /opt/spoolpi/.venv/bin/spoolpi run /etc/spoolpi/spoolpi.toml'
# SIGTERM reaches every process in the unit (KillMode=control-group); SpoolPi
# commits what's pending and finishes the batch in flight. Keep
# [shipper] stop_timeout_s below this.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=2
# A throwaway user with a private, writable /var/lib/spoolpi.
DynamicUser=yes
StateDirectory=spoolpi
# That user can't read root-only secrets. For an MQTT password or HTTP token,
# let systemd hand over a private copy and point the config at it:
#   LoadCredential=mqtt-password:/etc/spoolpi/mqtt-password
#   (spoolpi.toml)  password_file = "/run/credentials/spoolpi.service/mqtt-password"

[Install]
WantedBy=multi-user.target
